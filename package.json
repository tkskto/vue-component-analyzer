{
  "name": "@tkskto/vue-component-analyzer",
  "version": "0.10.3",
  "description": "Analyze dependency tree for Vue.js SFC (Single File Component)",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "bin": {
    "vca": "bin/analyze.js"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:typeScript": "tsc -p src/server/tsconfig.json -w",
    "dev:rollup": "rollup --config -w",
    "build": "tsc -p src/server/tsconfig.json && rollup --config",
    "lint": "eslint -c eslint.config.js src",
    "test": "npm run test:base",
    "test:base": "jest --config=jest.config.js --testTimeout=60000",
    "test:base:update": "jest --config=jest.config.js --updateSnapshot --testTimeout=60000",
    "tmp": "node bin/analyze.js --dir . -p 8888"
  },
  "keywords": [
    "Vue.js",
    "Vue",
    "component",
    "analyze",
    "tree"
  ],
  "author": {
    "name": "tkskto",
    "url": "https://github.com/tkskto/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tkskto/vue-component-analyzer.git"
  },
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "types",
    "views"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@typescript-eslint/parser": "8.67.0",
    "commander": "14.0.3",
    "ejs": "3.1.10",
    "express": "5.2.1",
    "get-tsconfig": "4.14.3",
    "globby": "16.2.3",
    "js-beautify": "1.15.4",
    "mkdirp": "3.0.1",
    "opener": "1.5.2",
    "vue-eslint-parser": "10.4.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@mitsue/eslint-config": "8.0.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/js-beautify": "1.14.3",
    "@types/mkdirp": "2.0.0",
    "@types/node": "24.13.3",
    "@types/opener": "1.4.3",
    "@types/ws": "8.18.1",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "eslint": "10.8.1",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.3.0",
    "npm-run-all2": "8.0.4",
    "rollup": "4.62.4",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  },
  "lint-staged": {
    "*.ts": [
      "npm run lint"
    ]
  }
}
